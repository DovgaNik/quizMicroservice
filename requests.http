POST http://127.0.0.1:3000/gemini/options
Content-Type: application/json

{
  "amountOfQuestions": 5,
  "amountOfOptions": 4,
  "amountOfMultipleAnswerQuestions": 1,
  "ignoreContext": true,
  "content": ""
}

